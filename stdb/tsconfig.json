/*
 * Based on the tsconfig from `spacetime init --lang typescript` (CLI 2.10.2).
 * The options in the second group are required by SpacetimeDB.
 */
{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",

    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["./src/**/*"]
}
