{
  "name": "@thermal-reserve/imessage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "spike:terminal": "tsx spike/hello-terminal.ts",
    "spike:send": "node --env-file=.env --import tsx spike/send-imessage.ts",
    "spike:whois": "node --env-file=.env --import tsx spike/whois.ts",
    "spike:stdb": "tsx spike/stdb-watch.ts",
    "spike:listen": "node --env-file=.env --import tsx spike/listen-imessage.ts",
    "spike:drive": "tsx spike/drive-dev.ts",
    "start": "node --env-file=.env --import tsx src/main.imessage.ts",
    "dev": "tsx src/main.terminal.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "qa": "scripts/qa-terminal.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@thermal-reserve/model": "0.1.0",
    "@thermal-reserve/stdb-bindings": "0.0.0",
    "spectrum-ts": "12.10.1"
  }
}
