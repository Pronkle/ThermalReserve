{
  "name": "thermal-reserve",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w apps/web",
    "dev": "npm run dev -w apps/web",
    "sync-physics": "node scripts/sync-physics.mjs",
    "check-physics": "node scripts/sync-physics.mjs --check",
    "data": "tsx data/scripts/build.ts"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
